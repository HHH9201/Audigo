[Desktop Entry]
Type=Application
Name=MusicHub
Comment=A Wayland-native music player
Exec=env GDK_BACKEND=wayland /usr/local/bin/MusicHub %F
Icon=/usr/share/icons/hicolor/128x128/apps/MusicHub.png

# 关键字段
Terminal=false
StartupWMClass=MusicHub
Categories=AudioVideo;Audio;Player;

# 支持的音频格式
MimeType=audio/mpeg;audio/flac;application/ogg;audio/x-vorbis+ogg;audio/wav;audio/x-aiff;audio/aac;audio/mp4;

# 让桌面环境知道这是“默认音乐播放器”候选
X-KDE-StartupNotify=false